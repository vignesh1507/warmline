{
  "name": "@warmline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "node ../../scripts/with-env.mjs prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "reset": "node ../../scripts/with-env.mjs prisma migrate reset --force",
    "seed": "node ../../scripts/with-env.mjs tsx prisma/seed.ts",
    "studio": "node ../../scripts/with-env.mjs prisma studio",
    "push": "node ../../scripts/with-env.mjs prisma db push",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@warmline/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.21.0"
  }
}
