{
  "name": "warmline",
  "private": true,
  "version": "0.1.0",
  "description": "A friendship companion that remembers what matters, helps you prepare, and follows up.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @warmline/web dev",
    "build": "pnpm --filter @warmline/db generate && pnpm --filter @warmline/web build",
    "start": "pnpm --filter @warmline/web start",
    "bridge": "pnpm --filter @warmline/bridge start",
    "db:generate": "pnpm --filter @warmline/db generate",
    "db:migrate": "pnpm --filter @warmline/db migrate",
    "db:deploy": "pnpm --filter @warmline/db deploy",
    "db:seed": "pnpm --filter @warmline/db seed",
    "db:studio": "pnpm --filter @warmline/db studio",
    "db:reset": "pnpm --filter @warmline/db reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "chrome:install": "pnpm --filter @warmline/bridge exec puppeteer browsers install chrome"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
