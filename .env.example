# ---------------------------------------------------------------------------
# Warmline — copy to .env and fill in. One file for the whole workspace.
# ---------------------------------------------------------------------------

# Postgres. A Postgres already running on your machine (see README for setup):
DATABASE_URL="postgresql://warmline:warmline@127.0.0.1:5432/warmline?schema=public"
# Or the bundled Docker one (docker compose up -d db), which uses port 5433:
# DATABASE_URL="postgresql://warmline:warmline@127.0.0.1:5433/warmline?schema=public"
# DigitalOcean Managed Postgres looks like this — keep sslmode=require:
# DATABASE_URL="postgresql://doadmin:PASSWORD@db-xxx.b.db.ondigitalocean.com:25060/warmline?sslmode=require"

# The passcode you type to open the app, and the key used to sign the session cookie.
APP_PASSCODE="let-me-in"
SESSION_SECRET="change-me-to-a-long-random-string"

# Gemma. aistudio | ollama | openrouter
AI_PROVIDER="aistudio"
AI_MODEL="gemma-4-31b-it"
AI_API_KEY=""
# OLLAMA_URL="http://127.0.0.1:11434"
# AI_TIMEOUT_MS="45000"

# Shared secret between the WhatsApp bridge and the web app. Any long random string.
BRIDGE_SHARED_SECRET="change-me-too"
# Where the bridge should post what it finds.
WEB_API_URL="http://127.0.0.1:3100"

# --- WhatsApp bridge ---------------------------------------------------------
# Replay a fixture conversation instead of connecting to WhatsApp. Start here.
WA_FAKE="1"
# Where the linked-session files live (keep this private; it is a login).
# WA_SESSION_DIR="./.wa-session"
# Point at a specific browser if the bridge cannot find one.
# PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Required inside Docker, not on a laptop.
# WA_CHROME_NO_SANDBOX="true"
